generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  RETURN_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         UserRole        @default(STAFF)
  movements    StockMovement[] @relation("MovementActor")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([role])
}

model Product {
  id                String          @id @default(cuid())
  sku               String          @unique
  name              String
  category          String
  unit              String
  price             Decimal         @db.Decimal(12, 2)
  lowStockThreshold Int             @default(5)
  movements         StockMovement[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([name])
  @@index([category])
}

model StockMovement {
  id             String       @id @default(cuid())
  productId      String
  actorId        String
  type           MovementType
  quantity       Int
  reason         String
  reference      String?
  idempotencyKey String?      @unique
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor   User    @relation("MovementActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([productId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([type, occurredAt])
}
