# ---------------------------------------------------------------------------
# StockLedger environment template. Copy the values you need into:
#   apps/api/.env   (backend, Prisma, seed, tests)
#   apps/web/.env   (frontend build-time API URL)
# Never commit real secrets. The values below are development defaults only.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://stockledger:stockledger_dev_password@localhost:5432/stockledger?schema=public"
# Separate database used by `npm test` (created by docker/postgres setup).
TEST_DATABASE_URL="postgresql://stockledger:stockledger_dev_password@localhost:5432/stockledger_test?schema=public"

# --- API server ------------------------------------------------------------
API_PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins for credentialed CORS.
CLIENT_ORIGIN=http://localhost:5173

# --- Authentication --------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h
COOKIE_NAME=stockledger_session
# lax | strict | none. Use `none` (requires HTTPS) only when web and API live
# on different sites. Same-site deployments should keep `lax`.
COOKIE_SAMESITE=lax

# --- Demo seed accounts (development only, change or delete in production) --
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=OwnerDemo123!
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=StaffDemo123!
SEED_STAFF2_EMAIL=staff2@example.com
SEED_STAFF2_PASSWORD=StaffDemo123!

# --- Frontend (apps/web/.env, exposed to the browser bundle) ----------------
VITE_API_URL=http://localhost:4000/api
